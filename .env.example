# Reference only: NOT automatically loaded. Set these in your shell.
# No API key or paid API is required.
DRAWINGLAB_ENGINE=klein
DRAWINGLAB_PORT=8765
DRAWINGLAB_DEVICE=cuda
DRAWINGLAB_CPU_OFFLOAD=1
